:root {
  --bg-page: #0F172A;
  --bg-surface: #1E293B;
  --bg-card: #1E293B;
  --border-color: #334155;
  --text-muted: #94A3B8;
  --text-main: #F8FAFC;
  --brand-indigo: #4F46E5;
  --brand-indigo-hover: #4338CA;
  --color-success: #10B981;
  --color-warning: #F59E0B;
  --color-danger: #EF4444;
}

*, *::before, *::after {
  box-sizing: border-box;
}

html, body, #root {
  width: 100%;
  height: 100%;
  height: 100dvh;
  margin: 0;
  padding: 0;
  background-color: var(--bg-page);
  color: var(--text-main);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow: hidden !important;
}

/* Layout Structure */
.crm-layout {
  display: flex;
  height: 100dvh;
  width: 100%;
  background-color: var(--bg-page);
  color: var(--text-main);
  position: relative;
  overflow: hidden;
}

.sidebar-overlay {
  display: none;
  pointer-events: none;
}

.sidebar-overlay.visible {
  display: block;
  pointer-events: auto;
  position: fixed;
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.7);
  z-index: 1000;
}

/* Toast Notifications System */
.toast-container {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 3000;
  display: flex;
  flex-direction: column;
  gap: 12px;
  pointer-events: none;
  max-width: 380px;
  width: calc(100% - 48px);
}

.toast-item {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-left-width: 4px;
  border-radius: 12px;
  padding: 14px 16px;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  pointer-events: auto;
  position: relative;
  overflow: hidden;
  animation: toastSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes toastSlideIn {
  from { opacity: 0; transform: translateX(100%); }
  to { opacity: 1; transform: translateX(0); }
}

.toast-close-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  transition: color 0.15s ease;
}

.toast-close-btn:hover {
  color: var(--text-main);
}

.toast-progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  transition: width 0.04s linear;
}

/* Sidebar Navigation - Fixed Viewport Column */
.crm-sidebar {
  width: 260px;
  height: 100dvh;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow-y: auto;
  background-color: var(--bg-surface);
  border-right: 1px solid var(--border-color);
  padding: 20px 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 24px;
  transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s ease-in-out;
  z-index: 100;
  position: relative;
}

.crm-sidebar.collapsed {
  width: 80px;
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}

.crm-sidebar.collapsed .sidebar-header {
  justify-content: center;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  width: 32px;
  height: 32px;
  background-color: var(--brand-indigo);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.brand-title {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.5px;
}

.sidebar-toggle-btn {
  background-color: var(--border-color);
  border: none;
  color: var(--text-muted);
  border-radius: 6px;
  padding: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 36px;
  min-width: 36px;
  position: relative;
  z-index: 102;
}

.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  background: transparent;
  color: var(--text-muted);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 500;
  font-size: 14px;
  min-height: 44px;
  transition: all 0.15s ease;
  position: relative;
  z-index: 102;
}

.crm-sidebar.collapsed .nav-item {
  justify-content: center;
}

.nav-item:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: var(--text-main);
}

.nav-item.active {
  background-color: var(--brand-indigo);
  color: #FFFFFF;
  font-weight: 600;
}

.nav-item-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-badge {
  background-color: var(--border-color);
  padding: 2px 8px;
  border-radius: 9999px;
  font-size: 11px;
}

.nav-item.active .nav-badge {
  background-color: rgba(255, 255, 255, 0.2);
}

/* Sidebar Bottom Container */
.sidebar-bottom {
  display: flex;
  flex-direction: column;
  gap: 16px;
  position: relative;
  z-index: 102;
}

.export-card {
  background-color: var(--bg-page);
  padding: 16px;
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.export-card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 12px;
}

.export-buttons {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.export-btn {
  padding: 9px 12px;
  background-color: var(--border-color);
  color: var(--text-main);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
  text-align: left;
  min-height: 36px;
  transition: background-color 0.15s ease;
  position: relative;
  z-index: 102;
}

.export-btn:hover {
  background-color: #475569;
}

.logout-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 12px;
  background-color: var(--color-danger);
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  min-height: 44px;
  transition: opacity 0.15s ease;
  position: relative;
  z-index: 102;
}

.crm-sidebar.collapsed .logout-btn {
  justify-content: center;
}

.logout-btn:hover {
  opacity: 0.9;
}

/* Main Workspace - Independent Scroll Area */
.crm-main {
  flex: 1;
  min-width: 0;
  height: 100dvh;
  overflow-y: auto;
  padding: 30px 40px;
  position: relative;
  z-index: 1;
}

/* Topbar Header */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  gap: 16px;
  background-color: var(--bg-page);
  padding-bottom: 10px;
  position: relative;
  z-index: 10;
}

.topbar-title-group h1 {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.5px;
}

.topbar-subtitle {
  margin: 4px 0 0 0;
  color: var(--text-muted);
  font-size: 14px;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.icon-btn-wrapper {
  background: transparent;
  border: none;
  cursor: pointer;
  position: relative;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 8px;
  height: 8px;
  background-color: var(--brand-indigo);
  border-radius: 9999px;
}

.user-avatar-badge {
  width: 36px;
  height: 36px;
  background-color: var(--border-color);
  border-radius: 9999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  cursor: pointer;
}

.mobile-menu-trigger {
  display: none;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 8px;
  border-radius: 8px;
  cursor: pointer;
  min-height: 44px;
  min-width: 44px;
  align-items: center;
  justify-content: center;
  z-index: 60;
}

/* KPI Cards Grid */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

.kpi-card {
  background-color: var(--bg-card);
  padding: 20px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kpi-label {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
}

.kpi-value {
  font-size: 28px;
  font-weight: 700;
  margin: 12px 0 4px 0;
  color: var(--text-main);
}

.kpi-subtext {
  color: var(--color-success);
  font-size: 12px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Global Search & Filters */
.search-filter-bar {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
  background-color: var(--bg-surface);
  padding: 16px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  position: relative;
  z-index: 5;
}

.search-input-wrapper {
  position: relative;
  flex: 1;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
}

.search-input {
  width: 100%;
  padding: 10px 10px 10px 40px;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-page);
  color: var(--text-main);
  outline: none;
  min-height: 44px;
}

.search-input:focus, .form-input:focus, .form-select:focus, .filter-select:focus {
  border-color: var(--brand-indigo);
  box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.2);
}

.filter-select {
  padding: 10px 16px;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-page);
  color: var(--text-main);
  outline: none;
  min-height: 44px;
}

/* Forms Section */
.form-card {
  background-color: var(--bg-surface);
  padding: 24px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  margin-bottom: 28px;
  position: relative;
  z-index: 5;
}

.form-title {
  margin: 0 0 16px 0;
  font-size: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.grid-form-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.grid-form-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.form-input, .form-select {
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  background-color: var(--bg-page);
  color: var(--text-main);
  min-height: 44px;
  outline: none;
}

.form-submit-btn {
  padding: 12px;
  background-color: var(--brand-indigo);
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  min-height: 44px;
  transition: background-color 0.15s ease;
}

.form-submit-btn:hover {
  background-color: var(--brand-indigo-hover);
}

.col-span-full {
  grid-column: 1 / -1;
}

/* Tables & Horizontal Scroll Container */
.table-container {
  background-color: var(--bg-surface);
  border-radius: 12px;
  border: 1px solid var(--border-color);
  overflow-x: auto;
  width: 100%;
  position: relative;
  z-index: 5;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 14px;
}

.data-table th {
  background-color: var(--bg-page);
  border-bottom: 1px solid var(--border-color);
  color: var(--text-muted);
  padding: 14px 20px;
  white-space: nowrap;
}

.data-table td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--border-color);
}

.data-table tr:hover {
  background-color: rgba(255, 255, 255, 0.02);
}

.action-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  border-radius: 4px;
  min-height: 36px;
  min-width: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
}

/* Modals */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  padding: 16px;
  backdrop-filter: blur(4px);
}

.modal-content {
  background-color: var(--bg-surface);
  padding: 28px;
  border-radius: 12px;
  width: min(460px, 92vw);
  max-height: 90dvh;
  overflow-y: auto;
  border: 1px solid var(--border-color);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  animation: modalScale 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  z-index: 2001;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.modal-actions {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}

@keyframes modalScale {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.tab-fade-enter {
  animation: fadeIn 0.25s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* MEDIA QUERIES */

/* Tablet View (640px - 1023px) */
@media (max-width: 1023px) {
  .crm-sidebar {
    width: 80px;
  }
  .sidebar-brand span, .nav-item-text, .export-card, .logout-btn span {
    display: none;
  }
  .nav-item {
    justify-content: center;
  }
  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .grid-form-3 {
    grid-template-columns: repeat(2, 1fr);
  }
  .crm-main {
    padding: 24px;
  }
  .mobile-menu-trigger {
    display: flex;
  }
}

/* Phone View (< 640px) */
@media (max-width: 639px) {
  .toast-container {
    top: 16px;
    right: 16px;
    left: 16px;
    max-width: none;
    width: auto;
  }

  .mobile-menu-trigger {
    display: flex;
  }
  
  .crm-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    height: 100dvh;
    width: 260px !important;
    transform: translateX(-100%);
    z-index: 1001;
  }
  
  .sidebar-brand span, .nav-item-text, .export-card, .logout-btn span {
    display: inline !important;
  }
  
  .nav-item {
    justify-content: space-between !important;
  }

  .crm-sidebar.drawer-open {
    transform: translateX(0);
  }

  .crm-main {
    padding: 16px;
  }

  .topbar-subtitle {
    display: none;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .grid-form-3, .grid-form-2 {
    grid-template-columns: 1fr;
  }

  .col-span-full {
    grid-column: span 1;
  }

  .search-filter-bar {
    flex-direction: column;
  }

  .modal-actions {
    flex-direction: column;
  }

  /* Table Card View on Mobile */
  .mobile-responsive-cards thead {
    display: none;
  }

  .mobile-responsive-cards, .mobile-responsive-cards tbody, .mobile-responsive-cards tr, .mobile-responsive-cards td {
    display: block;
    width: 100%;
  }

  .mobile-responsive-cards tr {
    margin-bottom: 12px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 12px;
  }

  .mobile-responsive-cards td {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgba(51, 65, 85, 0.5);
    text-align: right;
  }

  .mobile-responsive-cards td:last-child {
    border-bottom: none;
  }

  .mobile-responsive-cards td::before {
    content: attr(data-label);
    font-weight: 600;
    color: var(--text-muted);
    text-align: left;
    padding-right: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
